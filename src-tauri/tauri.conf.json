{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dtmoney",
  "version": "1.0.0",
  "identifier": "com.dtmoney.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "dtmoney",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "dialog": {
        "all": true,
        "open": true,
        "save": true
      },
      "fs": {
        "all": true,
        "readFile": true,
        "writeFile": true,
        "readDir": true,
        "copyFile": true,
        "createDir": true,
        "removeFile": true,
        "removeDir": true
      },
      "path": {
        "all": true
      },
      "window": {
        "all": true,
        "create": true,
        "center": true,
        "requestUserAttention": true,
        "setResizable": true,
        "setTitle": true,
        "maximize": true,
        "minimize": true,
        "close": true
      },
      "sql": {
        "all": true
      }
    },
    "windows": [
      {
        "title": "dtmoney - Personal Finance Manager",
        "label": "main",
        "url": "/",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "windows": {
        "wix": {
          "language": "en-US",
          "template": null,
          "fragmentPaths": null,
          "componentRefs": null,
          "componentGroupRefs": null,
          "featureRefs": null,
          "mergeRefs": null,
          "skipWebView2Install": false,
          "installMode": "perMachine",
          "upgradeCode": "{12345678-1234-1234-1234-123456789012}"
        },
        "nsis": {
          "installerIcon": "icons/icon.ico",
          "installMode": "perMachine",
          "licenseFile": null,
          "headerImage": null,
          "welcomeImage": null,
          "displayLanguageSelector": true,
          "allowElevation": true,
          "multiInstall": false
        }
      }
    }
  }
}